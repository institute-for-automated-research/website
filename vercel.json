{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.instituteforautomatedresearch.org"
        }
      ],
      "destination": "https://instituteforautomatedresearch.org/$1",
      "permanent": true
    },
    {
      "source": "/zeropaper.pdf",
      "destination": "/papers/iar-m/iar-m-001.pdf",
      "permanent": true
    }
  ]
}
