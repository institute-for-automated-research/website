---
// Override of Starlight's <PageTitle>: render the default title, then a
// provenance badge when the page declares `verified` frontmatter. This is
// the institute's differentiator — pages state when the recipe was last
// actually run, and against what.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const v = Astro.locals.starlightRoute?.entry?.data?.verified;
const tags: string[] = Astro.locals.starlightRoute?.entry?.data?.tags ?? [];
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC', // date is a plain YYYY-MM-DD; don't let host TZ shift it
  });
---

<Default><slot /></Default>

{
  v &&
    (() => {
      const licensed = v.access === 'licensed';
      return (
        <p
          class:list={['iar-verified', { 'iar-licensed': licensed }]}
          aria-label="Verification provenance"
        >
          <span class="iar-check" aria-hidden="true">
            {licensed ? '◆' : '✓'}
          </span>
          <strong>
            {licensed ? 'Access confirmed (licensed)' : 'Verified'}{' '}
            {fmt(v.date)}
          </strong>
          {v.with && (
            <>
              {licensed ? ' · via ' : ' · tested with '}
              {v.url ? <a href={v.url}>{v.with}</a> : <code>{v.with}</code>}
            </>
          )}
        </p>
      );
    })()
}

{
  tags.length > 0 && (
    <p class="iar-tags not-content" aria-label="Tags">
      {tags.map((t) => (
        <a href={`/wiki/tags/#${t}`}>{t}</a>
      ))}
    </p>
  )
}

<style>
  .iar-tags {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .iar-tags a {
    font-size: var(--sl-text-xs);
    text-decoration: none;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
  }
  .iar-tags a:hover {
    background: var(--sl-color-gray-6);
  }
  .iar-verified {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .iar-check {
    color: #2d5a3d;
    font-weight: 700;
  }
  .iar-licensed .iar-check {
    color: #9a6a1b; /* amber — licensed/paywalled, not the free green */
  }
  .iar-verified code {
    font-size: 0.95em;
  }
</style>
