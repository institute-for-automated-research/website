---
// Override of Starlight's <PageTitle>: render the default title, then a
// provenance badge when the page declares `verified` frontmatter. This is
// the institute's differentiator — pages state when the recipe was last
// actually run, and against what.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const v = Astro.locals.starlightRoute?.entry?.data?.verified;
const tags: string[] = Astro.locals.starlightRoute?.entry?.data?.tags ?? [];
// JEL classification for distilled papers. JF prints no JEL and neither
// Crossref nor OpenAlex carries it, so these are assigned by IAR from the
// abstract; the rendered line states that provenance so the codes are never
// mistaken for the journal's own classification.
const jel: { codes: string[]; assignedBy: string; date: string } | undefined =
  Astro.locals.starlightRoute?.entry?.data?.paper?.jel;

// Distilled-paper provenance: surface the model + date + role that we already
// store in `paper.extraction[]`. The model id is the text in parens of `by`
// (e.g. "paper-distiller (claude-sonnet-4-6)" -> "claude-sonnet-4-6"); a human
// name with no parens is shown verbatim. One line per page, driven by
// frontmatter so it stays in sync with the stored attestations.
const extraction: { by: string; date: string; role: string }[] =
  Astro.locals.starlightRoute?.entry?.data?.paper?.extraction ?? [];
const modelOf = (by: string) => by.match(/\(([^)]+)\)/)?.[1] ?? by;
const steps = extraction.map((e) => ({
  model: modelOf(e.by),
  date: e.date,
  role: e.role,
}));
const models = [...new Set(steps.map((s) => s.model))];

// Collapse repeated passes for the byline. A re-distilled / augmented page
// stores one entry per pass in frontmatter — [extracted, verified, extracted,
// verified, ...] — and that full history stays there for provenance. The
// rendered line only needs the first extraction and the most recent
// verification per model, so it reads "extracted <date>, last verified <date>"
// instead of doubling on every augment pass.
const collapse = (modelSteps: { model: string; date: string; role: string }[]) => {
  const extracted = modelSteps.filter((s) => s.role === 'extracted');
  const verified = modelSteps.filter((s) => s.role === 'verified');
  const others = modelSteps.filter(
    (s) => s.role !== 'extracted' && s.role !== 'verified',
  );
  const parts: { role: string; date: string }[] = [];
  if (extracted.length) parts.push({ role: 'extracted', date: extracted[0].date });
  if (verified.length)
    parts.push({
      role: verified.length > 1 ? 'last verified' : 'verified',
      date: verified[verified.length - 1].date,
    });
  for (const o of others) parts.push({ role: o.role, date: o.date });
  return parts;
};
const singleSteps = collapse(steps);
const multiSteps = models.flatMap((m) =>
  collapse(steps.filter((s) => s.model === m)).map((p) => ({ ...p, model: m })),
);

// Direct link to the page's raw Markdown twin, which carries the full
// frontmatter the rendered HTML does not surface (for papers: methods, scope,
// relatesTo, topics, dataAccess, the extraction attestations; for datasets: the
// verified block, access tier, tags). postbuild.mjs writes the twin at the
// docs-relative source path with a .md extension, so derive the href from the
// source file path: this stays exact for index pages (foo/index.md ->
// /wiki/foo/index.md) as well as leaf pages, where a pathname-based guess fails.
const isPaper = !!Astro.locals.starlightRoute?.entry?.data?.paper;
const filePath: string | undefined = Astro.locals.starlightRoute?.entry?.filePath;
// Only emit the link when we can derive the twin path exactly from the source
// file (so index pages map to /wiki/foo/index.md, not /wiki/foo.md). If the
// loader ever stops exposing filePath, omit the link rather than risk a 404.
const mdHref = filePath
  ? `/wiki/${filePath.replace(/^.*?content\/docs\//, '').replace(/\.mdx?$/, '.md')}`
  : null;
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC', // date is a plain YYYY-MM-DD; don't let host TZ shift it
  });
---

<Default><slot /></Default>

{
  v &&
    (() => {
      const licensed = v.access === 'licensed';
      // 'reachable' = endpoint confirmed live but the end-to-end pull was not
      // proven here; a lighter claim than the green "Verified" of a real fetch.
      const reachable = !licensed && v.level === 'reachable';
      const label = licensed
        ? 'Access confirmed (licensed)'
        : reachable
          ? 'Source reachable'
          : 'Verified';
      return (
        <p
          class:list={[
            'iar-verified',
            { 'iar-licensed': licensed, 'iar-reachable': reachable },
          ]}
          aria-label="Verification provenance"
        >
          <span class="iar-check" aria-hidden="true">
            {licensed ? '◆' : reachable ? '○' : '✓'}
          </span>
          <strong>
            {label}{' '}
            {fmt(v.date)}
          </strong>
          {v.with && (
            <>
              {licensed ? ' · via ' : reachable ? ' · checked ' : ' · tested with '}
              {v.url ? <a href={v.url}>{v.with}</a> : <code>{v.with}</code>}
            </>
          )}
        </p>
      );
    })()
}

{
  steps.length > 0 && (
    <p class="iar-distilled" aria-label="Distillation provenance">
      <span class="iar-mark" aria-hidden="true">
        {'◈'}
      </span>
      {models.length === 1 ? (
        <>
          <strong>Distilled by {models[0]}</strong>
          {' · '}
          {singleSteps.map((s, i) => (
            <>
              {i > 0 && ', '}
              {s.role}
              {' '}
              {fmt(s.date)}
            </>
          ))}
        </>
      ) : (
        <>
          <strong>Distilled</strong>
          {' · '}
          {multiSteps.map((s, i) => (
            <>
              {i > 0 && ', '}
              {s.role}
              {' by '}
              {s.model}
              {' '}
              {fmt(s.date)}
            </>
          ))}
        </>
      )}
    </p>
  )
}

{
  jel && jel.codes.length > 0 && (
    <p class="iar-jel" aria-label="JEL classification (IAR-assigned)">
      <span class="iar-mark" aria-hidden="true">{'◈'}</span>
      <strong>JEL (IAR-assigned):</strong>{' '}
      {jel.codes.join(', ')}
      <span class="iar-jel-note">
        {' · assigned from the abstract, not the journal'}
      </span>
    </p>
  )
}

{
  mdHref && (
    <p class="iar-meta" aria-label="Raw Markdown and metadata">
      <span class="iar-mark" aria-hidden="true">{'◈'}</span>
      {isPaper ? (
        <>
          Full structured metadata (methods, scope, relatesTo, topics, datasets):{' '}
          <a href={mdHref}>raw Markdown (.md)</a>
        </>
      ) : (
        <>
          View this page as <a href={mdHref}>raw Markdown (.md)</a>
        </>
      )}
    </p>
  )
}

{
  tags.length > 0 && (
    <p class="iar-tags not-content" aria-label="Tags">
      {tags.map((t) => (
        <a href={`/wiki/tags/#${t}`}>{t}</a>
      ))}
    </p>
  )
}

<style>
  .iar-tags {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .iar-tags a {
    font-size: var(--sl-text-xs);
    text-decoration: none;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
  }
  .iar-tags a:hover {
    background: var(--sl-color-gray-6);
  }
  .iar-verified {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .iar-check {
    color: #2d5a3d;
    font-weight: 700;
  }
  .iar-licensed .iar-check {
    color: #9a6a1b; /* amber: licensed/paywalled, not the free green */
  }
  .iar-reachable .iar-check {
    color: #0f6c78; /* teal: source reachable, a lighter claim than verified */
  }
  .iar-verified code {
    font-size: 0.95em;
  }
  .iar-distilled {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .iar-distilled .iar-mark {
    color: var(--sl-color-gray-4);
    margin-right: 0.15rem;
  }
  .iar-meta {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .iar-meta .iar-mark {
    color: var(--sl-color-gray-4);
    margin-right: 0.15rem;
  }
  .iar-jel {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .iar-jel .iar-mark {
    color: var(--sl-color-gray-4);
    margin-right: 0.15rem;
  }
  .iar-jel-note {
    color: var(--sl-color-gray-4);
  }
</style>
